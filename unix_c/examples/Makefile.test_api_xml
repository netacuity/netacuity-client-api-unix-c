#############################################################
##
## This is the Makefile for the test_api_xml of the NetAcuity
## server. This makefile defaults to linux, but has
## options to compile on Solaris and FreeBSD.
##
#############################################################

API=..
CC=gcc

## The following must be changed to point to the libxml2 includes directory
LIBXML2_DIR=/usr/include/libxml2/
LIBS=-lxml2

CFLAGS=-O3 -g -Wall -I. -I.. -I$(LIBXML2_DIR)
ALL=linux
TARGET=test_api_xml

DEFS =  -DHAVE_MALLOC_H=1 -DHAVE_SYS_SELECT_H=1 -DHAVE_NET_ROUTE_H=1 -DHAVE_STRERROR=1 -DHAVE_USLEEP=1 -DHAVE_SETLINEBUF=1 -DBYTESWAP_IP_HDR=1 -DHAVE_ICMP_NEXTMTU=1 
LINUX_ARGS=$(API)/netacuity_api.o test_api_xml.o
FREEBSD_ARGS=$(API)/netacuity_api.o test_api_xml.o
SOLARIS_ARGS=$(API)/netacuity_api.o test_api_xml.o




all: linux


## Make the linux executable.
linux: $(LINUX_ARGS)
	@echo -----------------------------------------------
	@echo ---  Making the LINUX $(TARGET) executable
	@echo -----------------------------------------------
	$(CC)  -o $(TARGET) $(LINUX_ARGS) $(LIBS)
	@echo -----------------------------------------------
	@echo ---  LINUX executable successfully made
	@echo -----------------------------------------------

## Make the freebsd executable.
freebsd: $(FREEBSD_ARGS)
	@echo -----------------------------------------------
	@echo ---  Making the FREEBSD $(TARGET) executable
	@echo -----------------------------------------------
	$(CC)  -o $(TARGET) $(FREEBSD_ARGS) $(LIBS)
	@echo -----------------------------------------------
	@echo ---  FREEBSD executable successfully made
	@echo -----------------------------------------------
	
## Make the solaris executable.
solaris: $(SOLARIS_ARGS)
	@echo -----------------------------------------------
	@echo ---  Making the SOLARIS $(TARGET) executable
	@echo -----------------------------------------------
	$(CC)  -o $(TARGET) $(SOLARIS_ARGS) $(LIBS) -lsocket -lnsl -lrt
	@echo -----------------------------------------------
	@echo ---  SOLARIS executable successfully made
	@echo -----------------------------------------------

clean: 
	rm  -f *.o
	rm  -f $(API)/*.o

	
$(API)/netacuity_api.o: $(API)/netacuity_api.c $(API)/netacuity_api.h

test_api_xml.o: test_api_xml.c $(API)/netacuity_api.h
